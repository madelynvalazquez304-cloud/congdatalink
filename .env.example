# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Client-side variables (VITE_ prefix for Vite)
VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_chat_id_here

# JSONBin for state storage (works with static sites)
# Get your free key from https://jsonbin.io/
JSONBIN_KEY=your_jsonbin_master_key_here
JSONBIN_ID=your_jsonbin_bin_id_here

# Client-side JSONBin (for polling)
VITE_JSONBIN_KEY=your_jsonbin_master_key_here
VITE_JSONBIN_ID=your_jsonbin_bin_id_here
